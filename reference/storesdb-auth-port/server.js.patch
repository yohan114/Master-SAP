+// [UMMS] gate all /api requests. Reads require a valid session (so results can be
+// site-scoped and nothing leaks to the unauthenticated); mutations additionally need
+// the mapped permission; DELETE routes carry their own requireAuthPerm inline.
+function permForMutation(req) {
+  const p = (req.baseUrl || '') + req.path;
+  if (/^\/api\/receipts\//.test(p)) return 'STORES.PRICE';   // updating a receipt = pricing / GRN
+  if (/^\/api\/issues/.test(p))      return 'STORES.ISSUE';
+  if (/^\/api\/transfers/.test(p))   return 'STORES.TRANSFER';
+  return 'STORES.WRITE';                                        // create/update items, batteries, general items, imports
+}
+app.use('/api', (req, res, next) => {
+  const m = req.method;
+  if (m === 'OPTIONS' || m === 'DELETE') return next();        // delete routes gate themselves
+  authMiddleware(req, res, () => {                             // all reads + writes require a session
+    if (m === 'GET' || m === 'HEAD') return next();            // read: authenticated, then site-scoped in-route
+    return requirePerm(permForMutation(req))(req, res, next);  // write: also needs the permission
+  });
+});
+// [UMMS] serve the tracker UI only to authenticated users
+function isAuthed(req) {
+  const t = req.cookies && req.cookies.umms_sid;
+  return !!(t && dbApi.get('SELECT 1 AS ok FROM sessions WHERE token=? AND expires_at>?', [t, new Date().toISOString()]));
+}
+app.get('/item_tracker.html', (req, res, next) => (isAuthed(req) ? next() : res.redirect('/login.html')));
+
