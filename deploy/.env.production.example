# UMMS storesdb — production environment. Copy to deploy/.env and fill in.
# NEVER commit the real .env (the repo .gitignore already blocks it). Load real
# secrets from your OS secret store / vault where possible.

# Marks session cookies Secure (HTTPS-only). Keep this = production behind TLS.
NODE_ENV=production

# App listen port (inside the container / on the host). nginx proxies to it.
PORT=4000

# SQLite database file. In Docker this is a mounted volume path; on a bare host
# point it at a persistent location you back up nightly.
INVENTORY_DB=/data/inventory.db

# Trust the reverse proxy so client IPs (audit log, rate limit) are real.
# 1 = trust the first proxy hop (nginx). Leave unset if the app is NOT behind a proxy.
TRUST_PROXY=1

# CORS: same-origin only unless you set this. Comma-separated EXACT origins for
# any cross-origin browser client. Leave empty for a single same-origin deployment.
CORS_ORIGINS=

# Physical site id that existing single-site data belongs to (default 1). Only
# change if you are running more than one site.
HOME_SITE_ID=1
